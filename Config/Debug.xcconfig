// Debug.xcconfig
// Debug-only overrides optimized for fast local iteration.

#include "Shared.xcconfig"

// Build only the host architecture — M-series Macs do not need x86_64 slices
// for local debug runs.
ONLY_ACTIVE_ARCH = YES

// Required for `@testable import` in unit tests.
ENABLE_TESTABILITY = YES

// Ensure `#if DEBUG` blocks compile in Debug.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
